# =============================================================================
# VertretungsFlow Configuration
# =============================================================================
# Kopieren Sie diese Datei nach .env und passen Sie die Werte an:
#   cp .env.example .env
#
# WICHTIG: Committen Sie .env NIEMALS ins Git-Repository!
# =============================================================================
#
# 🚀 PRODUCTION DEPLOYMENT:
# -------------------------
# 1. Generate secure secrets:
#    openssl rand -hex 32
# 2. Update ALL secrets below (SECRET_KEY, WORDPRESS_PROXY_SECRET, POSTGRES_PASSWORD)
# 3. Set DEBUG=false and ENVIRONMENT=production
# 4. Set CORS_ORIGINS to your production domain only
# 5. Deploy with: docker-compose -f docker-compose.prod.yml up -d
# 6. See DEPLOYMENT.md for full production checklist
#
# ⚠️  SECURITY VALIDATION:
# The backend will REFUSE to start if default secrets are detected!
# This prevents accidental deployment with insecure defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=VertretungsFlow
DEBUG=false

# Environment (optional, used for production checks)
# Set to "production" to enable additional security validations
# ENVIRONMENT=production

# JWT Secret Key - ÄNDERN SIE DIES IN PRODUKTION!
# ⚠️  REQUIRED IN PRODUCTION - No default allowed!
# Generieren mit: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# Access Token Gültigkeit (in Minuten)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# -----------------------------------------------------------------------------
# CORS - Erlaubte Origins (komma-separiert)
# -----------------------------------------------------------------------------
# ⚠️  PRODUCTION: Set to production domain ONLY (no localhost!)
# Development: localhost:3000,8080 for testing
# Production: https://your-wordpress-domain.com
#
# 🔒 SECURITY: If ENVIRONMENT=production, validation will BLOCK:
#    - localhost origins (http://localhost:*)
#    - 127.0.0.1 origins
#    - Wildcard origins (*)
#
# Examples:
# Development: http://localhost:3000,http://localhost:8080
# Production: https://intranet.school.com
# Multi-site: https://site1.school.com,https://site2.school.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://intranet.school.local

# Frontend URL (für E-Mail-Links zu Absenz-Details)
# Beispiel: https://ihre-schule.de/absenzflow (WordPress-Seite mit [absenzflow] Shortcode)
# ⚠️  PRODUCTION: Must match one of the CORS_ORIGINS above
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Format: postgresql://user:password@host:port/database
# ⚠️  CHANGE 'changeme' PASSWORD IN PRODUCTION!
DATABASE_URL=postgresql://absenzflow:changeme@postgres:5432/absenzflow

# Für docker-compose (wird von docker-compose.yml verwendet)
POSTGRES_USER=absenzflow
# ⚠️  REQUIRED IN PRODUCTION - Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=changeme
POSTGRES_DB=absenzflow

# -----------------------------------------------------------------------------
# LDAP / Active Directory Configuration
# -----------------------------------------------------------------------------
LDAP_SERVER=ldap.schule.local
LDAP_PORT=389
LDAP_USE_SSL=false

# Base DN für User-Suche
LDAP_BASE_DN=dc=schule,dc=local

# Service Account für LDAP-Bind
LDAP_BIND_DN=cn=absenzflow,ou=services,dc=schule,dc=local
LDAP_BIND_PASSWORD=your-ldap-bind-password

# LDAP Attribute Mapping (optional, falls Standard-Attribute verwendet werden)
# LDAP_USERNAME_ATTR=sAMAccountName
# LDAP_EMAIL_ATTR=mail
# LDAP_FIRSTNAME_ATTR=givenName
# LDAP_LASTNAME_ATTR=sn
# LDAP_DISPLAYNAME_ATTR=displayName

# -----------------------------------------------------------------------------
# WebUntis API Configuration
# -----------------------------------------------------------------------------
# WebUntis Server (ohne https://)
WEBUNTIS_SERVER=neilo.webuntis.com

# API-Benutzer (Lehrer-Account mit Leserechten)
WEBUNTIS_USERNAME=api-benutzer
WEBUNTIS_PASSWORD=api-passwort

# -----------------------------------------------------------------------------
# SMTP / E-Mail Configuration
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.schule.local
SMTP_PORT=587
SMTP_USE_TLS=true

# SMTP-Credentials (falls erforderlich)
SMTP_USERNAME=absenzflow@schule.de
SMTP_PASSWORD=smtp-passwort

# Absender-Adresse
SMTP_FROM=absenzflow@schule.de

# -----------------------------------------------------------------------------
# WebUntis Cache (Performance-Optimierung)
# -----------------------------------------------------------------------------
# Aktiviert Caching von WebUntis Stammdaten (Fächer, Klassen, Räume, Stundenraster)
WEBUNTIS_CACHE_ENABLED=true

# Cache-Gültigkeit in Stunden (Standard: 168 = 7 Tage)
# Daten werden automatisch neu geladen wenn Cache abläuft
WEBUNTIS_CACHE_TTL_HOURS=168

# -----------------------------------------------------------------------------
# File Upload Configuration
# -----------------------------------------------------------------------------
# Verzeichnis für hochgeladene Dateien (Attachments)
# WICHTIG: Muss außerhalb des webroots liegen für Sicherheit!
#
# Docker-Deployment (EMPFOHLEN):
# - Verwenden Sie /app/uploads (wird automatisch auf ./backend/uploads gemountet)
# - Dateien sind persistent und überleben Container-Neustarts
UPLOAD_DIR=/app/uploads
#
# Alternatives Setup (ohne Docker oder custom Mount):
# UPLOAD_DIR=/var/absenzflow-uploads
#
# Maximale Dateigröße (in Bytes, Default: 10 MB)
# MAX_FILE_SIZE=10485760

# -----------------------------------------------------------------------------
# pgAdmin (optional - nur für Development)
# -----------------------------------------------------------------------------
# Starten mit: docker-compose --profile dev up -d
# Zugriff: http://localhost:5050
PGADMIN_EMAIL=admin@absenzflow.local
PGADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# WordPress Plugin Configuration
# -----------------------------------------------------------------------------
# Shared Secret für WordPress Proxy Authentication
# ⚠️  REQUIRED IN PRODUCTION - No default allowed!
# WICHTIG: Muss identisch im WordPress Plugin (Admin-Einstellungen) konfiguriert werden!
# Generieren mit: openssl rand -hex 32
WORDPRESS_PROXY_SECRET=change-this-shared-secret-in-production

# Diese Werte werden im WordPress Admin-Bereich konfiguriert:
# - Backend API URL: http://your-backend-server:8000/api
# - Backend API Secret: <gleicher Wert wie WORDPRESS_PROXY_SECRET oben>
#
# 🔒 SECURITY: The backend validates this secret on every request.
# If it doesn't match, all API calls will fail with "Invalid proxy secret".

# -----------------------------------------------------------------------------
# Absence Auto-Deletion Configuration (Optional)
# -----------------------------------------------------------------------------
# Alte Absenzen automatisch löschen um Speicher freizugeben
#
# ABSENCE_RETENTION_DAYS:
# - Anzahl Tage, um Absenzen nach ihrem end_date zu behalten
# - Absenzen älter als dieser Wert werden automatisch gelöscht
# - Beispiel: retention_days=90 → löscht Absenzen 90+ Tage nach deren Ende
# - Standard: 90 Tage
# - Empfehlung: 90-180 Tage für Datenschutz/Audit-Konformität
#
# ABSENCE_AUTO_DELETE_ENABLED:
# - Aktiviert/deaktiviert automatisches Cleanup (läuft täglich um 02:00 Uhr)
# - Standard: true
# - Auf false setzen um Auto-Deletion zu deaktivieren (manuelles Cleanup immer noch verfügbar)
#
# 🗑️  CLEANUP-VERHALTEN:
# - Läuft automatisch jeden Tag um 02:00 Uhr (wenn ABSENCE_AUTO_DELETE_ENABLED=true)
# - Kann manuell getriggert werden: POST /api/admin/cleanup-old-absences (nur Admin)
# - Löscht automatisch alle verknüpften Dateien aus dem Storage
# - Protokolliert Cleanup-Ergebnisse in Application-Logs
#
# ⚠️  WARNUNG:
# - ALLE Absenzen älter als retention_days werden gelöscht (unabhängig vom Status)
# - Dies umfasst auch unverarbeitete (eingereicht) und genehmigte (genehmigt) Absenzen
# - Keine Wiederherstellung möglich nach dem Löschen - regelmäßige DB-Backups sind essentiell!
# - Erste Cleanup sollte in den Logs überwacht werden
#
ABSENCE_RETENTION_DAYS=90
ABSENCE_AUTO_DELETE_ENABLED=true

# ABSENCE_MIN_ADVANCE_DAYS:
# - Mindestvorlauf für neue Absenzmeldungen in Kalendertagen (heute + N)
# - Frühere Tage sind im Kalender gesperrt, das Backend lehnt sie ebenfalls ab
# - Gilt für alle Gründe (auch Krankheit), NICHT für Planer/Admins
# - Standard: 0 (deaktiviert)
ABSENCE_MIN_ADVANCE_DAYS=0

# ═══════════════════════════════════════════════════════════════
# BENACHRICHTIGUNGEN
# ═══════════════════════════════════════════════════════════════
#
# NOTIFY_DEPT_HEADS_ON_SUBMISSION:
# - Aktiviert E-Mail-Benachrichtigung an Abteilungsleitungen bei neuer Abwesenheitsmeldung
# - Standard: true
# - Hinweis: Abteilungsleiter müssen sich einmalig in VertretungsFlow eingeloggt haben,
#   damit ihr Eintrag in der Backend-Datenbank angelegt wird. Nur dann werden
#   sie von get_recipients_by_roles() gefunden.
#
NOTIFY_DEPT_HEADS_ON_SUBMISSION=true
